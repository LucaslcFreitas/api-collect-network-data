generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id         String            @id @default(uuid()) @db.Uuid
  tokenHash  String            @unique
  appVersion  String?
  deviceModel String?
  os          String?
  createdAt  DateTime          @default(now())
  lastSeenAt DateTime?
  revokedAt DateTime?
  status     ParticipantStatus @default(ACTIVE)

  batches  Batch[]

  @@map("participants")
}

model Morphology {
  id          String   @id @default(uuid()) @db.Uuid
  environment String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now())

  @@map("morphology")
}

model Topography {
  id          String   @id @default(uuid()) @db.Uuid
  environment String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now())

  @@map("topography")
}

model Batch {
  id               String   @id @default(uuid()) @db.Uuid
  participantId    String   @db.Uuid
  clientBatchId    String   @db.VarChar(64)
  createdAt        DateTime @default(now())
  measurementCount Int
  schemaVersion    Int      @default(1)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  measurements Measurement[]

  @@unique([participantId, clientBatchId])
  @@index([participantId])
  @@index([createdAt])
  @@map("batches")
}

model Measurement {
  id         String   @id @default(uuid()) @db.Uuid
  batchId    String   @db.Uuid
  measuredAt DateTime
  receivedAt DateTime @default(now())

  environment      String? @db.VarChar(100)
  latitude         Float?
  longitude        Float?
  altitude         Float?
  accuracy         Float?
  altitudeAccuracy Float?
  speed            Float?
  heading          Float?

  accelerometerX Float?
  accelerometerY Float?
  accelerometerZ Float?
  gyroscopeX     Float?
  gyroscopeY     Float?
  gyroscopeZ     Float?

  servingRegistered      Boolean?
  servingTechnology      String?
  servingCellId          BigInt?
  servingPci             Int?
  servingTac             Int?
  servingArfcn           Int?
  servingMcc             String?
  servingMnc             String?
  servingRsrp            Float?
  servingRsrq            Float?
  servingRssi            Float?
  servingSinr            Float?
  servingTimingAdvance   Int?

  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  neighboringCells NeighboringCell[]

  @@index([batchId])
  @@index([measuredAt])
  @@map("measurements")
}

model NeighboringCell {
  id            String @id @default(uuid()) @db.Uuid
  measurementId String @db.Uuid

  registered Boolean?
  technology String?

  cellId BigInt?
  pci    Int?
  tac    Int?
  arfcn  Int?

  mcc String?
  mnc String?

  rsrp Float?
  rsrq Float?
  rssi Float?
  sinr Float?
  timingAdvance Int?

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId])
  @@map("neighboring_cells")
}

enum ParticipantStatus {
  ACTIVE
  REVOKED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id         String            @id @default(uuid()) @db.Uuid
  tokenHash  String            @unique
  appVersion  String?
  deviceModel String?
  os          String?
  createdAt  DateTime          @default(now())
  lastSeenAt DateTime?
  revokedAt DateTime?
  status     ParticipantStatus @default(ACTIVE)

  batches  Batch[]

  @@map("participants")
}

model Batch {
  id               String   @id @default(uuid()) @db.Uuid
  participantId    String   @db.Uuid
  clientBatchId    String   @db.VarChar(64)
  createdAt        DateTime @default(now())
  measurementCount Int
  schemaVersion    Int      @default(1)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  measurements Measurement[]

  @@unique([participantId, clientBatchId])
  @@index([participantId])
  @@index([createdAt])
  @@map("batches")
}

model Measurement {
  id         String   @id @default(uuid()) @db.Uuid
  batchId    String   @db.Uuid
  measuredAt DateTime
  receivedAt DateTime @default(now())

  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  location         Location?
  motion           Motion?
  servingCell      ServingCell?
  neighboringCells NeighboringCell[]

  @@index([batchId])
  @@index([measuredAt])
  @@map("measurements")
}

model Location {
  id            String @id @default(uuid()) @db.Uuid
  measurementId String @unique @db.Uuid

  latitude         Float?
  longitude        Float?
  altitude         Float?
  accuracy         Float?
  altitudeAccuracy Float?
  speed            Float?
  heading          Float?

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model Motion {
  id            String @id @default(uuid()) @db.Uuid
  measurementId String @unique @db.Uuid

  accelerometerX Float?
  accelerometerY Float?
  accelerometerZ Float?

  gyroscopeX Float?
  gyroscopeY Float?
  gyroscopeZ Float?

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@map("motion")
}

model ServingCell {
  id            String @id @default(uuid()) @db.Uuid
  measurementId String @unique @db.Uuid

  registered Boolean?
  technology String?

  cellId BigInt?
  pci    Int?
  tac    Int?
  arfcn  Int?

  mcc String?
  mnc String?

  rsrp Float?
  rsrq Float?
  rssi Float?
  sinr Float?
  timingAdvance Int?

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@map("serving_cells")
}

model NeighboringCell {
  id            String @id @default(uuid()) @db.Uuid
  measurementId String @db.Uuid

  registered Boolean?
  technology String?

  cellId BigInt?
  pci    Int?
  tac    Int?
  arfcn  Int?

  mcc String?
  mnc String?

  rsrp Float?
  rsrq Float?
  rssi Float?
  sinr Float?
  timingAdvance Int?

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId])
  @@map("neighboring_cells")
}

enum ParticipantStatus {
  ACTIVE
  REVOKED
}
